{
  "manifest_version": 3,
  "name": "CryptoChat",
  "version": "0.8.0",
  "description": "End-to-end encrypted text on Discord, Slack, WhatsApp, Telegram, Instagram, X, and Facebook.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://discord.com/*",
    "https://*.slack.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://www.instagram.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "https://retiredroca.github.io/*"
  ],
  "background": {
    "service_worker": "src/background-bundle.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://*.slack.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://www.instagram.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.facebook.com/*",
        "https://www.messenger.com/*",
        "https://retiredroca.github.io/*"
      ],
      "js": [
        "src/adapters/discord.js",
        "src/adapters/slack.js",
        "src/adapters/others.js",
        "src/adapters/instagram.js",
        "src/adapters/twitter.js",
        "src/adapters/facebook.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "CryptoChat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
